[Unit]
Description=Hermes Gmail evidence to Event Layer bridge
After=hermes-gmail.service
RequiresMountsFor=/srv/hermes

[Service]
Type=oneshot
User=@ENGINE_USER@
Group=hermesreconcile
WorkingDirectory=/srv/hermes/gmail-event
ExecStart=/srv/hermes/gmail/venv/bin/python -u /srv/hermes/gmail-event/app/gmail_event_extract.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-gmail-event

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
SupplementaryGroups=
UMask=0077
MemoryMax=160M
TasksMax=24

# The bridge has neither OAuth nor channel credentials.  It sees only Gmail's
# published snapshot and the existing Event Layer data it must update.
InaccessiblePaths=-/etc/hermes-secrets
InaccessiblePaths=-/srv/hermes/gmail/state
InaccessiblePaths=-/srv/hermes/calendar/state
InaccessiblePaths=-/srv/hermes/channel-gateway
InaccessiblePaths=-/srv/hermes/coding-worker
InaccessiblePaths=-/srv/hermes/hermes-data/.env
InaccessiblePaths=-/srv/hermes/hermes-data/auth.json
InaccessiblePaths=-/srv/hermes/hermes-data/sessions
InaccessiblePaths=-/srv/hermes/hermes-data/memories
InaccessiblePaths=-/run/docker.sock
InaccessiblePaths=-/var/run/docker.sock

ReadOnlyPaths=/srv/hermes/gmail/index
ReadWritePaths=/srv/hermes/hermes-data/events
ReadWritePaths=/srv/hermes/gmail-event/reconcile

