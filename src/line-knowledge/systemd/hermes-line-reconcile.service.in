[Unit]
Description=Hermes LINE Knowledge downstream event extraction and commitment reconciliation
RequiresMountsFor=/srv/hermes
ConditionPathExists=/srv/hermes/hermes-data/tools/line-knowledge/reconcile-line.sh
Wants=hermes-classifier-broker.service
After=hermes-classifier-broker.service

[Service]
Type=oneshot
User=hermeslinereconcile
Group=hermesreconcile
WorkingDirectory=/srv/hermes/hermes-data/tools/line-knowledge
Environment=HOME=/srv/hermes/hermes-data/events
Environment=PYTHONPATH=/srv/hermes/hermes-data/tools:/srv/hermes/hermes-data
Environment=HERMES_CLASSIFIER_SOCKET=/run/hermes/classifier.sock
Environment=HERMES_CLASSIFY_PARALLEL=1
ExecStart=/srv/hermes/hermes-data/tools/line-knowledge/reconcile-line.sh
TimeoutStartSec=10min
UMask=0027

# Resource limits (Section 31 & 32)
MemoryHigh=250M
MemoryMax=350M
CPUQuota=80%

# Security hardening (Section 19)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Explicitly Denied Access (Section 16 & 22)
InaccessiblePaths=-/run/docker.sock
InaccessiblePaths=-/var/run/docker.sock
InaccessiblePaths=-/etc/hermes-secrets
InaccessiblePaths=-/opt/hermes-stack/.env
InaccessiblePaths=-/srv/hermes/antigravity/config
InaccessiblePaths=-/srv/hermes/antigravity/secrets
InaccessiblePaths=-/home/
InaccessiblePaths=-/srv/hermes/gmail
InaccessiblePaths=-/srv/hermes/calendar
InaccessiblePaths=-/srv/hermes/channel-gateway

# Tools and data dependencies (Section 21)
ReadOnlyPaths=/srv/hermes/hermes-data/tools
ReadOnlyPaths=/srv/hermes/knowledge/line
ReadOnlyPaths=/srv/hermes/hermes-data/knowledge-index/line
ReadOnlyPaths=/srv/hermes/hermes-data/commitments
ReadOnlyPaths=/run/hermes

# State and output directories (Section 20)
ReadWritePaths=/srv/hermes/hermes-data/events
ReadWritePaths=/srv/hermes/hermes-data/logs
